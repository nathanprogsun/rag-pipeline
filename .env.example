OPENAI_API_KEY=sk-cp-
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_MODEL=MiniMax-M3
OPENAI_MAX_CONCURRENT=8
OPENAI_EMBEDDING_MAX_CONCURRENT=12
OPENAI_RERANK_MAX_CONCURRENT=4

# LangSmith 观测（可选；开启 tracing 且配置 API Key 后 trace 才会上报）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-pipeline
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# 开发库；集成测试建议切到专用库避免污染，例如 .../rag_test
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

# Embedding
OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_API_KEY=sk-
OPENAI_EMBEDDING_MODEL=text-embedding-v4
OPENAI_EMBEDDING_DIM=1536

# Rerank (DashScope compatible-api)
OPENAI_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
OPENAI_RERANK_API_KEY=sk-
OPENAI_RERANK_MODEL=qwen3-rerank
