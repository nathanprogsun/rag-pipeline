# Copy to .env and fill in real keys.
# All keys below inherit defaults from rag-pipeline's settings.

# Embedding (required for retrieval)
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_MODEL=text-embedding-v3

# LLM (required for citation generation)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

# Rerank (optional)
OPENAI_RERANK_API_KEY=
OPENAI_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
OPENAI_RERANK_MODEL=qwen3-rerank

# Database
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag